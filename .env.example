# Copy this file to .env and fill in your values.
# docker compose reads .env automatically.

# ── Whisper ───────────────────────────────────────────────────────────────────
# ASR backend: faster_whisper (CTranslate2, ~2× faster) | openai_whisper (PyTorch, reference)
WHISPER_BACKEND=faster_whisper

# faster-whisper models: tiny | base | small | medium | large-v2 | large-v3 | large-v3-turbo
# openai-whisper models: tiny | base | small | medium | large | large-v2 | large-v3 | turbo
WHISPER_MODEL=large-v2

# Concurrent WhisperModel instances sharing the GPU.
# Recommended values for a single H200 (141 GB VRAM) — faster-whisper float16:
#   tiny:           WHISPER_WORKERS=48   (~0.15 GB/instance)
#   base:           WHISPER_WORKERS=32   (~0.29 GB/instance)
#   small:          WHISPER_WORKERS=16   (~0.93 GB/instance)
#   medium:         WHISPER_WORKERS=8    (~3.06 GB/instance)
#   large-v2/v3:    WHISPER_WORKERS=4    (~6.17 GB/instance)
#   large-v3-turbo: WHISPER_WORKERS=8    (~3.10 GB/instance)
#
# Whisper-only mode: multiply by ~1.6 (more VRAM available).
# Mixed mode (with LLM): use values above as-is.
WHISPER_WORKERS=4

# Precision: float16 (best quality) | int8_float16 (saves VRAM, <1% WER penalty)
WHISPER_COMPUTE_TYPE=float16

# ── LLM ───────────────────────────────────────────────────────────────────────
# Path to model weights inside the container (mounted via volume)
LLM_MODEL_PATH=/models/gpt-oss-20b

# Host path where model weights live (mapped to /models in container)
LLM_MODEL_HOST_PATH=/path/to/your/model/weights

# Fraction of H200 VRAM vLLM may use for weights + KV cache.
# LLM-only test: 0.95 (maximum)
# Mixed test:    0.45 (leaves room for Whisper)
LLM_GPU_UTIL=0.45

# Maximum sequence length (input + output tokens)
LLM_MAX_MODEL_LEN=8192

# Maximum concurrent sequences in the vLLM scheduler
LLM_MAX_NUM_SEQS=256

# Weight dtype: float16 | bfloat16 | float32
LLM_DTYPE=float16

# ── Benchmark ─────────────────────────────────────────────────────────────────
WHISPER_URL=http://localhost:8001
LLM_URL=http://localhost:8002
RESULTS_DIR=./results

# ── Audio format sweep ────────────────────────────────────────────────────────
# Formats to include in bench-formats (comma-separated)
AUDIO_FORMATS=wav,flac,opus

# Sample rates to test (comma-separated, Hz)
AUDIO_SAMPLE_RATES=16000,48000

# Concurrency for the format sweep (kept fixed to isolate format overhead)
FORMAT_BENCH_CONCURRENCY=10

# ── Real audio files ──────────────────────────────────────────────────────────
# Drop your audio files here (WAV, FLAC, Opus, MP3, WebM, M4A all supported).
# Sub-folder structure wav_16000/ / wav_48000/ / flac_16000/ etc. is auto-detected.
# Flat folder also works — format inferred from extension, rate probed by ffprobe.
REAL_AUDIO_DIR=./fixtures/real_audio
